# Frontend
frontend/.next/
frontend/node_modules/
frontend/.env*.local

# Windows reserved device names — Git Bash > NUL redirect bazen dosya
# yaratiyor (NUL Windows'ta block edilmesi gereken ad ama Git Bash bypass eder).
# Ornek vaka: `next build > nul` -> frontend/nul ortaya cikar.
nul
NUL
**/nul
**/NUL

# Genel
.DS_Store
*.log
gitleaks-report.txt

# IDE / editor workspace files (kullanıcıya özel, repo'ya ait degil)
.obsidian/
.vscode/
.idea/

# Claude Code lokal state
.claude/scheduled_tasks.lock

# Kubernetes secrets — secrets.example.yaml commit edilir, secrets.yaml asla
k8s/secrets.yaml

# Lokal credentials referansı (dev .env yedekleri + test fixture'lar) — ASLA commit edilmez
.credentials.local.md
.credentials.local.*

# Claude Code lokal ayarlar (kişisel — SSH izin kuralı vb.)
.claude/settings.local.json
