# ─── Production .env örneği ──────────────────────────────────────────────────
# Production deploy öncesi tüm değerleri kendi anahtarlarınızla doldurun.
# Bu dosya repo'da, gerçek değerler kubernetes Secret + 1Password'da kalır.

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=kfinans
POSTGRES_PASSWORD=guclu-sifre-buraya          # openssl rand -base64 24
POSTGRES_DB=kfinans

# ─── Backend — Auth ──────────────────────────────────────────────────────────
SECRET_KEY=openssl-rand-hex-32-ile-uret       # openssl rand -hex 32
FERNET_KEY=python-fernet-generate-key-ile-uret  # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Production: access token kısa, refresh uzun
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Backend — Dış servisler ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...                  # console.anthropic.com
INFURA_API_KEY=                                # opsiyonel; boşsa public RPC fallback
RESEND_API_KEY=re_...                          # resend.com (kfinans.app domain doğrulanmış)
EMAIL_FROM=KFinans <noreply@kfinans.app>

# ─── Backend — CORS ──────────────────────────────────────────────────────────
# Frontend'in çağrı yaptığı origin'ler. JSON list formatı.
CORS_ORIGINS=["https://kfinans.app","https://www.kfinans.app"]

# ─── Backend — Güvenlik header'ları (FAZ C2) ─────────────────────────────────
ENABLE_SECURITY_HEADERS=true
HSTS_MAX_AGE=31536000
# Backend JSON-only API: katı CSP. Swagger UI kullanmıyorsanız bu yeterli.
CSP_POLICY=default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'

# ─── Backend — TrustedHost (FAZ C3) ──────────────────────────────────────────
# Production'da yalnızca kendi domain'inizi listeleyin (Host header injection koruması).
ALLOWED_HOSTS=["kfinans.app","www.kfinans.app","api.kfinans.app"]

# ─── Backend — Frontend URL (mail link prefix'i) ────────────────────────────
FRONTEND_URL=https://kfinans.app

# ─── Frontend ────────────────────────────────────────────────────────────────
# Path-based ingress (Faz D1): /api/* backend'e yönlendirilir.
NEXT_PUBLIC_API_URL=https://kfinans.app/api
