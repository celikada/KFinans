# Veritabanı — asyncpg driver gerektirir
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/kfinans

# JWT — openssl rand -hex 32 ile üret
SECRET_KEY=your-secret-key-change-this-in-production

# Fernet — Python'da: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
FERNET_KEY=your-fernet-key-generate-with-fernet

# Claude API
ANTHROPIC_API_KEY=sk-ant-...
# Claude modeli (varsayılan claude-sonnet-4-6); ileride 4.7 veya başka bir
# modele geçmek için bu değeri değiştirmek yeterli, kod değişikliği gerekmez.
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=1024

# Ethereum RPC — Infura veya Alchemy (opsiyonel, public RPC de kullanılabilir)
INFURA_API_KEY=

# Sonic RPC (varsayılan: https://rpc.soniclabs.com, değiştirmek gerekmez)
SONIC_RPC_URL=https://rpc.soniclabs.com

# Avalanche RPC (varsayılan değerler yeterli)
AVALANCHE_P_API_URL=https://api.avax.network/ext/bc/P
AVALANCHE_C_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Web Push (VAPID) — tarayıcı/PWA bildirimleri
# Anahtar üretimi (Python):
#   from py_vapid import Vapid
#   v = Vapid(); v.generate_keys()
#   print(v.public_key_urlsafe_base64, v.private_key_urlsafe_base64)
# veya CLI:  npx web-push generate-vapid-keys
# Public key frontend'e GET /push/vapid-public-key ile servis edilir.
# Boş bırakılırsa push servisi no-op (dev/CI güvenli — gönderim 0 döner).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:celikada@gmail.com

# E-posta (Resend) — kullanıcı kayıt doğrulama
RESEND_API_KEY=re_...
EMAIL_FROM=KFinans <noreply@kfinans.app>
FRONTEND_URL=http://localhost:3000
VERIFY_TOKEN_EXPIRE_HOURS=24

# Sürüm bildirimleri (release notes) otomasyonu
# ADMIN_EMAILS: virgülle ayrılmış; bu e-postalar GİRİŞTE otomatik is_admin olur
# (manuel SQL gerekmez). Boş = kimse otomatik admin değil.
ADMIN_EMAILS=
# RELEASE_NOTES_TOKEN: CI/CD `POST /release-notes/send` çağrısında X-Release-Token
# header'ı ile admin JWT yerine kullanır. Güçlü rastgele değer; boş = token yolu kapalı.
RELEASE_NOTES_TOKEN=
