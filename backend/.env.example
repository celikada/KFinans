# Veritabanı — asyncpg driver gerektirir
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/kfinans

# JWT — openssl rand -hex 32 ile üret
SECRET_KEY=your-secret-key-change-this-in-production

# Fernet — Python'da: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
FERNET_KEY=your-fernet-key-generate-with-fernet

# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Ethereum RPC — Infura veya Alchemy (opsiyonel, public RPC de kullanılabilir)
INFURA_API_KEY=

# Sonic RPC (varsayılan: https://rpc.soniclabs.com, değiştirmek gerekmez)
SONIC_RPC_URL=https://rpc.soniclabs.com

# Avalanche RPC (varsayılan değerler yeterli)
AVALANCHE_P_API_URL=https://api.avax.network/ext/bc/P
AVALANCHE_C_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# E-posta (Resend) — kullanıcı kayıt doğrulama
RESEND_API_KEY=re_...
EMAIL_FROM=KFinans <noreply@kfinans.app>
FRONTEND_URL=http://localhost:3000
VERIFY_TOKEN_EXPIRE_HOURS=24
